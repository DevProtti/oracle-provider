{
  "name": "@devprotti/oracle-genai",
  "version": "2026.4.9",
  "description": "OpenClaw Oracle GenAI provider plugin",
  "type": "module",
  "scripts": {
    "build": "esbuild ./index.ts --bundle --outfile=./dist/index.js --platform=node --format=esm --external:openclaw --external:openclaw/* --external:oci-common --external:oci-generativeai --external:oci-generativeaiinference",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:matrix": "node ./scripts/run-oracle-model-matrix.mjs"
  },
  "files": [
    "dist/index.js",
    "openclaw.plugin.json",
    "package.json",
    "README.md",
    "docs/providers.png",
    "docs/models.png"
  ],
  "dependencies": {
    "@mariozechner/pi-ai": "0.65.0",
    "oci-common": "2.126.2",
    "oci-generativeai": "2.126.2",
    "oci-generativeaiinference": "2.126.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "openclaw": "2026.6.8",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.8"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:@devprotti/oracle-genai",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.6.8"
    },
    "compat": {
      "pluginApi": ">=2026.6.8"
    },
    "build": {
      "openclawVersion": "2026.6.8"
    },
    "release": {
      "publishToClawHub": true
    }
  },
  "engines": {
    "node": ">=24.17.0"
  }
}
